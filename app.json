{
  "expo": {
    "name": "Progres",
    "slug": "gym-tracker",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/progres-icon.png",
    "scheme": "gymtracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.progres.gymtracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.progres.gymtracker",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#C4F36B",
        "foregroundImage": "./assets/images/progres-foreground.png",
        "monochromeImage": "./assets/images/progres-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/progres-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D100E",
          "image": "./assets/images/progres-icon.png",
          "imageWidth": 100
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d46dc696-5807-4b7f-98e8-5f51660c3e56"
      }
    },
    "owner": "sajmon96"
  }
}
